{
  "_readme": "Place at config/splash_schedule.json in the repo. Splash designs are Lottie files in splash/. Title and sub are drawn by the app (Flutter Text) from params. style = eid | victory | newyear. Use {year} in text for the year. Text changes need no version bump; bump version only when the Lottie file itself changes. No active event and default disabled = plain black splash.",
  "enabled": true,
  "timezone": "+06:00",
  "load_budget_ms": 3000,
  "default": {
    "enabled": true,
    "file": "splash/default.json",
    "version": 1
  },
  "events": [
    {
      "id": "winter-dark",
      "_note": "Winter season, 24 Oct to 15 Feb every year. Lowest priority, so festival designs override it.",
      "enabled": true,
      "yearly": true,
      "start": "10-24",
      "end": "02-15",
      "priority": 10,
      "file": "splash/winter.json",
      "version": 1
    },
    {
      "id": "new-year",
      "enabled": true,
      "yearly": true,
      "start": "12-31",
      "end": "01-02",
      "priority": 50,
      "file": "splash/newyear.json",
      "version": 1,
      "params": {
        "style": "newyear",
        "title": "Happy\nNew Year",
        "title_size": 56,
        "sub": "Welcome {year}"
      }
    },
    {
      "id": "victory-day",
      "enabled": true,
      "yearly": true,
      "start": "12-15",
      "end": "12-16",
      "priority": 60,
      "file": "splash/victory.json",
      "version": 1,
      "params": {
        "style": "victory",
        "title": "Victory Day",
        "sub": "16 December"
      }
    },
    {
      "id": "independence-day",
      "enabled": true,
      "yearly": true,
      "start": "03-25",
      "end": "03-26",
      "priority": 60,
      "file": "splash/victory.json",
      "version": 1,
      "params": {
        "style": "victory",
        "title": "Independence Day",
        "title_size": 34,
        "sub": "26 March"
      }
    },
    {
      "id": "eid-ul-fitr-2027",
      "_note": "Set the exact dates after moon sighting, then enable.",
      "enabled": false,
      "start": "2027-03-10",
      "end": "2027-03-12",
      "priority": 80,
      "file": "splash/eid.json",
      "version": 1,
      "params": {
        "style": "eid",
        "title": "Eid Mubarak",
        "sub": "Eid al-Fitr"
      }
    },
    {
      "id": "eid-ul-adha-2027",
      "_note": "Set the exact dates after moon sighting, then enable.",
      "enabled": false,
      "start": "2027-05-17",
      "end": "2027-05-19",
      "priority": 80,
      "file": "splash/eid.json",
      "version": 1,
      "params": {
        "style": "eid",
        "title": "Eid Mubarak",
        "sub": "Eid al-Adha"
      }
    }
  ]
}
